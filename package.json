{
  "name": "@iyulab/house-style",
  "version": "0.1.4",
  "description": "The iyulab house theme: a CSS-only theme for @iyulab components — tokens, component recipes, line-of-business layout patterns and a Tailwind CSS v4 preset — plus the guide site that documents it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/house-style.git"
  },
  "type": "module",
  "style": "./styles/index.css",
  "types": "./styles/index.d.ts",
  "exports": {
    ".": {
      "types": "./styles/index.d.ts",
      "default": "./styles/index.css"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "styles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/**",
    "./src-app/**"
  ],
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:guide": "node scripts/check-guide.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:ladder": "node scripts/check-ladder.mjs",
    "check:start-here": "node scripts/check-start-here.mjs",
    "check:start-here:local": "node scripts/check-start-here.mjs --local",
    "pretest": "node -e \"if(require('fs').existsSync('../../scripts/sibling-dist-check.js'))require('child_process').execFileSync('node',['../../scripts/sibling-dist-check.js'],{stdio:'inherit'})\"",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "iyulab": {
    "upstreamChecks": {
      "@iyulab/components": [
        "check:ladder"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pretendard": "^1.3.9"
  },
  "peerDependencies": {
    "@iyulab/components": "^2.0.0",
    "@iyulab/flex-table": ">=0.41.0",
    "@iyulab/modern-app": ">=0.34.0"
  },
  "peerDependenciesMeta": {
    "@iyulab/flex-table": {
      "optional": true
    },
    "@iyulab/modern-app": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iyulab/components": "^2.0.0",
    "@iyulab/data-components": "^0.47.0",
    "@iyulab/enterprise": "^0.29.0",
    "@iyulab/flex-table": "^0.64.0",
    "@iyulab/modern-app": "^0.48.0",
    "@iyulab/router": "^0.21.0",
    "@iyulab/u-widgets": "^0.28.0",
    "@lit/react": "^1.0.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "echarts": "^6.1.0",
    "lit": "^3.3.2",
    "msw": "^3.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
