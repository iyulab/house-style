{
  "name": "@iyulab/house-style",
  "version": "0.0.0",
  "private": true,
  "description": "The iyulab house theme: a CSS-only theme for @iyulab components — tokens, component recipes, line-of-business layout patterns and a Tailwind CSS v4 preset — plus the guide site that documents it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/house-style.git"
  },
  "type": "module",
  "style": "./styles/index.css",
  "exports": {
    ".": "./styles/index.css",
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "styles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:start-here": "node scripts/check-start-here.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "pretendard": "^1.3.9"
  },
  "peerDependencies": {
    "@iyulab/components": "^2.0.0",
    "@iyulab/flex-table": ">=0.41.0",
    "@iyulab/modern-app": ">=0.34.0"
  },
  "peerDependenciesMeta": {
    "@iyulab/flex-table": {
      "optional": true
    },
    "@iyulab/modern-app": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iyulab/components": "^1.54.0",
    "@iyulab/data-components": "^0.32.0",
    "@iyulab/enterprise": "^0.20.0",
    "@iyulab/modern-app": "^0.33.0",
    "@iyulab/router": "^0.17.0",
    "@iyulab/u-widgets": "^0.23.0",
    "@lit/react": "^1.0.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "echarts": "^6.1.0",
    "lit": "^3.3.2",
    "msw": "^3.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
